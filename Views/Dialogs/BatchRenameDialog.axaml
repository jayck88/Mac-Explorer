<controls:DialogWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:models="using:MacExplorer.Models"
        x:Class="MacExplorer.Views.Dialogs.BatchRenameDialog"
        Title="批量重命名" Width="800" Height="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlassEffectBg}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="批量重命名" FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <!-- Body: Left rules, Right preview -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="12">
            <!-- Left: Rule settings -->
            <Border Grid.Column="0" CornerRadius="8"
                    Background="{DynamicResource ColorBgHover}"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="规则设置" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>

                        <!-- Rule type selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="规则类型" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <ComboBox x:Name="RuleTypeCombo" SelectedIndex="0"
                                      SelectionChanged="OnRuleTypeChanged">
                                <ComboBoxItem Content="查找替换"/>
                                <ComboBoxItem Content="添加前缀"/>
                                <ComboBoxItem Content="添加后缀"/>
                                <ComboBoxItem Content="添加序号"/>
                                <ComboBoxItem Content="添加日期"/>
                                <ComboBoxItem Content="大小写转换"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Find/Replace section -->
                        <StackPanel x:Name="FindReplaceSection" Spacing="6">
                            <TextBox x:Name="FindTextBox" PlaceholderText="查找..."
                                     TextChanged="OnRuleChanged"/>
                            <TextBox x:Name="ReplaceTextBox" PlaceholderText="替换为..."
                                     TextChanged="OnRuleChanged"/>
                        </StackPanel>

                        <!-- Prefix section -->
                        <StackPanel x:Name="PrefixSection" Spacing="4" IsVisible="False">
                            <TextBlock Text="前缀文本" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <TextBox x:Name="PrefixTextBox" PlaceholderText="输入前缀..."
                                     TextChanged="OnRuleChanged"/>
                        </StackPanel>

                        <!-- Suffix section -->
                        <StackPanel x:Name="SuffixSection" Spacing="4" IsVisible="False">
                            <TextBlock Text="后缀文本" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <TextBox x:Name="SuffixTextBox" PlaceholderText="输入后缀..."
                                     TextChanged="OnRuleChanged"/>
                        </StackPanel>

                        <!-- Sequence section -->
                        <StackPanel x:Name="SequenceSection" Spacing="4" IsVisible="False">
                            <TextBlock Text="起始序号" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <NumericUpDown x:Name="SeqStartBox" Value="1" Minimum="0"
                                           ValueChanged="OnRuleChanged"/>
                            <TextBlock Text="步长" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <NumericUpDown x:Name="SeqStepBox" Value="1" Minimum="1"
                                           ValueChanged="OnRuleChanged"/>
                            <TextBlock Text="位数" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <NumericUpDown x:Name="SeqPadBox" Value="2" Minimum="1" Maximum="10"
                                           ValueChanged="OnRuleChanged"/>
                        </StackPanel>

                        <!-- Date section -->
                        <StackPanel x:Name="DateSection" Spacing="4" IsVisible="False">
                            <TextBlock Text="日期格式" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <TextBox x:Name="DateFormatBox" Text="yyyy-MM-dd"
                                     TextChanged="OnRuleChanged"/>
                        </StackPanel>

                        <!-- Case section -->
                        <StackPanel x:Name="CaseSection" Spacing="4" IsVisible="False">
                            <TextBlock Text="转换方式" FontSize="11"
                                       Foreground="{DynamicResource ColorTextTertiary}"/>
                            <ComboBox x:Name="CaseModeCombo" SelectedIndex="0"
                                      SelectionChanged="OnRuleChanged">
                                <ComboBoxItem Content="大写"/>
                                <ComboBoxItem Content="小写"/>
                                <ComboBoxItem Content="标题格式"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Preview -->
            <Border Grid.Column="1" CornerRadius="8"
                    Background="{DynamicResource ColorBgHover}"
                    Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" Margin="4,0,4,4">
                        <TextBlock Grid.Column="0" Text="原文件名" FontSize="11"
                                   Foreground="{DynamicResource ColorTextTertiary}"/>
                        <TextBlock Grid.Column="1" Text="新文件名" FontSize="11"
                                   Foreground="{DynamicResource ColorTextTertiary}"/>
                        <TextBlock Grid.Column="2" Text="状态" FontSize="11"
                                   Foreground="{DynamicResource ColorTextTertiary}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PreviewList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BatchRenamePreviewItem">
                                    <Grid ColumnDefinitions="*,*,60" Margin="4,2"
                                          Background="Transparent">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OriginalName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding NewName}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource ColorTextPrimary}"/>
                                        <TextBlock Grid.Column="2"
                                                   FontSize="11"
                                                   Text="{Binding ErrorReason}"
                                                   Foreground="#E5484D"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="StatusText" Classes="link"
                    IsHitTestVisible="False" FontSize="11"
                    Foreground="{DynamicResource ColorTextTertiary}"/>
            <Button Classes="secondary" Click="OnCancel">取消</Button>
            <Button x:Name="ApplyButton" Classes="primary" Click="OnApply"
                    IsEnabled="True">应用</Button>
        </StackPanel>
    </Grid>
</controls:DialogWindow>

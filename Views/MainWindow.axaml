<controls:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MacExplorer.ViewModels"
        xmlns:icons="using:MacExplorer.Assets"
        xmlns:local="using:MacExplorer.Views"
        xmlns:controls="using:MacExplorer.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MacExplorer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="False"
        Title="Mac Explorer"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="680">

    <controls:AppWindow.Styles>
        <Style Selector="Button.title-nav-button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" Easing="QuadraticEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.title-nav-button PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}"/>
        </Style>
        <Style Selector="Button.title-nav-back">
            <Setter Property="Background" Value="{DynamicResource ColorSurfaceSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        </Style>
        <Style Selector="Button.title-nav-back PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        </Style>
        <Style Selector="Button.title-nav-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ColorBgHover}"/>
        </Style>
        <Style Selector="Button.title-nav-back:pointerover">
            <Setter Property="Background" Value="{DynamicResource ColorBgHoverStrong}"/>
        </Style>
        <Style Selector="Button.title-nav-button:pressed">
            <Setter Property="Background" Value="{DynamicResource ColorBgHoverStrong}"/>
            <Setter Property="RenderTransform" Value="scale(0.94)"/>
        </Style>
        <Style Selector="Button.title-nav-button:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource ColorAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.title-nav-button:disabled">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.42"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
        </Style>
        <Style Selector="Button.title-nav-button:disabled PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ColorTextDisabled}"/>
        </Style>

        <Style Selector="Grid.title-search-host">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style Selector="Grid.title-search-expanded">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="Border.title-search-surface">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.145,1)"/>
            <Setter Property="RenderTransformOrigin" Value="1,0.5"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.11" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.title-search-content">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateX(8px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.13" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.title-search-trigger">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AddressbarBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="QuadraticEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.title-search-trigger PathIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextTertiary}"/>
        </Style>
        <Style Selector="Button.title-search-trigger:pointerover">
            <Setter Property="Background" Value="{DynamicResource AddressbarBgHover}"/>
        </Style>
        <Style Selector="Button.title-search-trigger:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)"/>
        </Style>

        <Style Selector="Grid.title-search-host:pointerover Grid.title-search-expanded, Grid.title-search-host:focus-within Grid.title-search-expanded, Grid.title-search-host.has-query Grid.title-search-expanded">
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
        <Style Selector="Grid.title-search-host:pointerover Border.title-search-surface, Grid.title-search-host:focus-within Border.title-search-surface, Grid.title-search-host.has-query Border.title-search-surface">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="Grid.title-search-host:pointerover Grid.title-search-content, Grid.title-search-host:focus-within Grid.title-search-content, Grid.title-search-host.has-query Grid.title-search-content">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="Grid.title-search-host:pointerover Button.title-search-trigger, Grid.title-search-host:focus-within Button.title-search-trigger, Grid.title-search-host.has-query Button.title-search-trigger">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.84)"/>
        </Style>
        <Style Selector="Grid.title-search-host:focus-within Button.title-search-trigger, Grid.title-search-host.has-query Button.title-search-trigger">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style Selector="controls|AppWindow:compact Grid.title-search-host">
            <Setter Property="Width" Value="180"/>
        </Style>
        <Style Selector="controls|AppWindow:compact Grid.title-search-expanded">
            <Setter Property="Width" Value="180"/>
        </Style>
        <Style Selector="controls|AppWindow:compact Border.title-search-surface">
            <Setter Property="Width" Value="180"/>
        </Style>
    </controls:AppWindow.Styles>

    <controls:AppWindow.TitleBarContent>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0" VerticalAlignment="Center"
              chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left"
                        chrome:WindowDecorationProperties.ElementRole="User">
                <Button x:Name="SidebarToggleButton" Classes="ghost toolbar-btn w32"
                        ToolTip.Tip="显示或隐藏侧栏" AutomationProperties.Name="显示或隐藏侧栏"
                        IsVisible="False" Click="ToggleSidebar">
                    <PathIcon Data="{x:Static icons:Icons.List}" Width="14" Height="14"/>
                </Button>
                <Button x:Name="BackButton" Classes="title-nav-button title-nav-back"
                        ToolTip.Tip="后退 ⌘[" AutomationProperties.Name="后退"
                        Click="NavigateBack" IsEnabled="{Binding FileList.CanGoBack}">
                    <PathIcon Data="{x:Static icons:Icons.Back}"/>
                </Button>
                <Button x:Name="ForwardButton" Classes="title-nav-button title-nav-forward"
                        ToolTip.Tip="前进 ⌘]" AutomationProperties.Name="前进"
                        Click="NavigateForward" IsEnabled="{Binding FileList.CanGoForward}">
                    <PathIcon Data="{x:Static icons:Icons.Forward}"/>
                </Button>
                <Button Classes="ghost toolbar-btn w32" ToolTip.Tip="上级目录 ⌘↑" Click="NavigateUp"
                        IsVisible="{Binding FileList.IsHomePage, Converter={StaticResource BoolNotConverter}}">
                    <PathIcon Data="{x:Static icons:Icons.Up}" Width="14" Height="14"/>
                </Button>
                <Button Classes="ghost toolbar-btn w32" ToolTip.Tip="刷新 ⌘R" Click="RefreshView">
                    <PathIcon Data="{x:Static icons:Icons.Refresh}" Width="14" Height="14"/>
                </Button>
            </StackPanel>

            <local:BreadcrumbBar Grid.Column="1" x:Name="BreadcrumbControl"
                                 DataContext="{Binding FileList}"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="280" MaxWidth="700"
                                 Margin="12,0"
                                 VerticalAlignment="Center"
                                 chrome:WindowDecorationProperties.ElementRole="User"/>

            <!-- Search: icon by default, expands on hover/focus/active query. -->
            <Grid Grid.Column="2" x:Name="SearchHost" Classes="title-search-host"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  chrome:WindowDecorationProperties.ElementRole="User">
                <Grid Classes="title-search-expanded" HorizontalAlignment="Right">
                    <Border Classes="search-bar title-search-surface"/>
                    <Grid Classes="title-search-content" ColumnDefinitions="Auto,*,Auto" Margin="10,4">
                        <PathIcon Grid.Column="0" Data="{x:Static icons:Icons.Search}"
                                  Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox"
                                 Classes="search-input omnibox-input"
                                 PlaceholderText="搜索..."
                                 Text="{Binding FileList.SearchQuery, Mode=OneWay}"
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown"/>
                        <Button Grid.Column="2" x:Name="SearchClearBtn" Content="✕"
                                Classes="ghost close-btn search-clear-btn"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Width="20" Height="20" Padding="0" Background="Transparent" FontSize="11"
                                Foreground="{DynamicResource TextMutedBrush}" IsVisible="False"
                                Click="ClearSearch"/>
                    </Grid>
                </Grid>
                <Button x:Name="SearchRevealButton" Classes="title-search-trigger"
                        ToolTip.Tip="搜索" AutomationProperties.Name="搜索"
                        IsTabStop="False" Click="RevealSearch">
                    <PathIcon Data="{x:Static icons:Icons.Search}"/>
                </Button>
            </Grid>
        </Grid>
    </controls:AppWindow.TitleBarContent>

    <Grid>
    <Border x:Name="RootLayout" CornerRadius="0">
        <Grid ColumnDefinitions="Auto,*" Margin="8 0 8 8">
            <!-- Left: Sidebar (full height) — Liquid Glass -->
            <controls:SurfaceCard x:Name="SidebarHost" Grid.Column="0" Width="260" CornerRadius="16" Padding="0"
                                       Margin="0,0,4,0">
                <controls:SurfaceCard.Content>
                    <Grid RowDefinitions="*,Auto">
                        <local:FinderSidebarView Grid.Row="0"
                                                  x:Name="SidebarControl"
                                                  DataContext="{Binding FileList}"/>
                        <Button Grid.Row="1" x:Name="SettingsButton"
                                Margin="8,4,8,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" Padding="10,6"
                                Classes="ghost glass-btn-ghost">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{x:Static icons:Icons.Settings}" Width="14" Height="14"/>
                                <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </controls:SurfaceCard.Content>
            </controls:SurfaceCard>

            <!-- Right: Toolbar + Content -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="4,0,0,0">
                <!-- Row 0: Toolbar — Liquid Glass card -->
                <controls:SurfaceCard Grid.Row="0" CornerRadius="14" Padding="0"
                                           Margin="0,0,0,4">
                    <controls:SurfaceCard.Content>
                        <Border CornerRadius="14" ClipToBounds="True">
                            <local:FinderToolbar x:Name="ToolbarControl" DataContext="{Binding FileList}"/>
                        </Border>
                    </controls:SurfaceCard.Content>
                </controls:SurfaceCard>

                <!-- Row 1: Content + Status bar — single Liquid Glass card -->
                <controls:SurfaceCard Grid.Row="1" CornerRadius="14" Padding="0">
                    <controls:SurfaceCard.Content>
                        <Border CornerRadius="14" ClipToBounds="True">
                        <Grid RowDefinitions="*,Auto">
                            <SplitView x:Name="InfoDrawer"
                                       DisplayMode="Inline"
                                       PanePlacement="Right"
                                       OpenPaneLength="380"
                                       CompactPaneLength="0"
                                       IsPaneOpen="False">
                                <SplitView.Pane>
                                    <Grid x:Name="InfoPanelPane" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" x:Name="InfoPanelResizeHandle" Background="Transparent"
                                                Cursor="SizeWestEast"
                                                PointerPressed="OnInfoPanelResizePressed"
                                                PointerMoved="OnInfoPanelResizeMoved"
                                                PointerReleased="OnInfoPanelResizeReleased"/>
                                        <local:InfoPanelView Grid.Column="1"
                                                             x:Name="InfoPanelControl"
                                                             DataContext="{Binding FileList}"/>
                                    </Grid>
                                </SplitView.Pane>
                                <SplitView.Content>
                                    <Grid>
                                        <local:FileListView x:Name="FileListControl"
                                                            DataContext="{Binding FileList}"
                                                            IsVisible="True"/>
                                        <local:HomeView x:Name="HomeViewControl"
                                                        DataContext="{Binding FileList}"
                                                        IsVisible="False"/>
                                        <local:AiView x:Name="AiViewControl"
                                                      DataContext="{Binding FileList}"
                                                      IsVisible="False"/>
                                    </Grid>
                                </SplitView.Content>
                            </SplitView>

                            <!-- Status bar -->
                            <Border Grid.Row="1" Height="32">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,0">
                                    <TextBlock Grid.Column="0" Text="{Binding FileList.StatusSummaryText}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="8,0,12,0"
                                          IsVisible="{Binding FileList.HasStatusMessage}">
                                        <TextBlock Grid.Column="0" Text="·" FontSize="11"
                                                   Margin="0,0,5,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileList.StatusText}"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding FileList.StatusText}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                    <Button Grid.Column="2" x:Name="TaskButton" IsVisible="False"
                                            Classes="ghost glass-btn-ghost" Padding="8,3" Margin="0,2,8,2"
                                            Click="ToggleTaskPanel">
                                        <TextBlock x:Name="TaskButtonText" Text="后台任务" FontSize="11" VerticalAlignment="Center"/>
                                    </Button>
                                    <Border Grid.Column="3" IsVisible="{Binding FileList.HasLocationStatus}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding FileList.LocationStatusTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6"
                                                     IsVisible="{Binding FileList.IsRemoteLocationConnected}"
                                                     Fill="{DynamicResource ColorSuccess}"
                                                     VerticalAlignment="Center"/>
                                            <Ellipse Width="6" Height="6"
                                                     IsVisible="{Binding FileList.IsRemoteLocationDisconnected}"
                                                     Fill="{DynamicResource ColorTextDisabled}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileList.LocationStatusText}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        </Border>
                    </controls:SurfaceCard.Content>
                </controls:SurfaceCard>
            </Grid>
        </Grid>
    </Border>
    <!-- Task overlay panel — bottom-right overlay (before DialogHost so dialogs paint above it) -->
    <Border x:Name="TaskOverlayPanel"
            IsVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Width="356" MaxHeight="432"
            Margin="0,0,10,42">
        <Border.RenderTransform>
            <TranslateTransform X="380" Y="0"/>
        </Border.RenderTransform>
        <!-- Outer Grid with margin to make room for shadow (same pattern as ContextMenu template) -->
        <Grid Margin="12">
            <!-- Shadow layer — full-size, not clipped -->
            <Border Background="{DynamicResource GlassMenuBg}"
                    CornerRadius="12"
                    BoxShadow="{DynamicResource WindowShadow}"/>
            <!-- Content layer — clipped for rounded corners -->
            <Border Background="{DynamicResource GlassMenuBg}"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto" Margin="6">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0">
                        <TextBlock Grid.Column="0" x:Name="TaskPanelTitle"
                                   Text="后台任务" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,1,0,0"/>
                        <Button Grid.Column="1" x:Name="ClearPanelButton"
                                Classes="ghost compact" Content="清空"
                                Click="ClearAllPanelTasks" Margin="0,0,2,0"
                                FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" x:Name="ClosePanelButton"
                                Classes="ghost compact"
                                Width="26" Height="26" Padding="4"
                                VerticalAlignment="Center" Click="CloseTaskPanel">
                            <PathIcon Data="{x:Static icons:Icons.Close}"
                                      Width="10" Height="10"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Task list -->
                    <ScrollViewer Grid.Row="1" x:Name="TaskListScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="330">
                        <StackPanel x:Name="TaskItemsPanel" Margin="0,2,0,4" Spacing="0"/>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" x:Name="PanelFooter"
                          IsVisible="False" Margin="0,2,0,0">
                        <Button x:Name="ClearCompletedButton" Content="清除已完成"
                                Classes="ghost compact" FontSize="12"
                                HorizontalAlignment="Right"
                                Click="ClearCompletedPanel"/>
                    </Grid>
                </Grid>
            </Border>
	        </Grid>
	    </Border>
	    <Border x:Name="ModalInteractionOverlay"
	            IsVisible="False"
	            Background="{DynamicResource OverlayBrush}"
	            IsHitTestVisible="True"/>
	    <controls:DialogHost x:Name="DialogHost"/>
	    </Grid>
	</controls:AppWindow>
